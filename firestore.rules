rules_version = '2';

// ===============================================================
// Ciudad Viva - Reglas de Seguridad de Cloud Firestore
// ===============================================================
//
// 1. Colecciones Públicas de Agenda Cultural:
//    - events, locations, towns, categories
//    - Lectura: Pública y abierta a todos los ciudadanos (sin autenticación).
//    - Escritura (crear, actualizar, eliminar): Restringida a gestores y administradores autenticados.
//
// 2. Colección de Administración de Usuarios:
//    - users
//    - Lectura y escritura: Restringida a usuarios autenticados.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Colecciones de la agenda cultural y de ocio
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /towns/{townId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Colección de perfiles de gestores y superadministradores
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Denegación por defecto del resto de rutas no especificadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
